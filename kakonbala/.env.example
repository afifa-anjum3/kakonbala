# ── Firebase (Client SDK) ──────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Firebase Admin (Server / API routes) ──────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts → Generate Key
# Paste the ENTIRE contents of the downloaded JSON file as one line (minified)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── SSLCommerz ────────────────────────────────────────────────────────────
# Register at https://developer.sslcommerz.com
# Use sandbox credentials for testing, live credentials for production
SSL_STORE_ID=your_store_id
SSL_STORE_PASSWORD=your_store_password
SSL_IS_LIVE=false        # set to true when going live

# ── Site URL ──────────────────────────────────────────────────────────────
# Your Vercel deployment URL (no trailing slash)
# e.g. https://hastkala.vercel.app  OR  https://www.hastkala.com
SITE_URL=https://your-site.vercel.app
